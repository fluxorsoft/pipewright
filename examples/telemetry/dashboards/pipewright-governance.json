{
  "title": "Pipewright: governance and risk",
  "uid": "pipewright-governance",
  "description": "What the platform's rules held or refused, and why; decisions waiting for a person; every run on the record. Telemetry is for operations: the evidence stays the event log.",
  "tags": [
    "pipewright",
    "opentelemetry",
    "governance",
    "risk"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "title": "Pipewright dashboards",
      "type": "dashboards",
      "tags": [
        "pipewright"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "hide": 0
      },
      {
        "name": "usecase",
        "label": "Use case",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(pipewright_runs_started_total, usecase)",
          "refId": "usecase"
        },
        "definition": "label_values(pipewright_runs_started_total, usecase)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "### The rules at work\nEvery run goes through the launcher, which applies the platform's rules before anything runs: integrity, feature contracts, scoring that waits for a person. This shows what they held and refused. **The record of decisions stays the event log and the evidence packs.**"
      }
    },
    {
      "type": "stat",
      "title": "Held for a person",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(pipewright_runs_refused_total{usecase=~\"$usecase\",reason=\"held\"}[$__range]))) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FBBF24"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Refused: integrity",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(pipewright_runs_refused_total{usecase=~\"$usecase\",reason=\"integrity\"}[$__range]))) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#F87171"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Refused: feature contract",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(pipewright_runs_refused_total{usecase=~\"$usecase\",reason=\"features\"}[$__range]))) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#F87171"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Retrain decisions waiting",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(pipewright_cases_open{usecase=~\"$usecase\"})) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#F59E0B"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Held and refused, by reason",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(pipewright_runs_refused_total{usecase=~\"$usecase\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "lineInterpolation": "smooth",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Held and refused, by use case",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (usecase) (increase(pipewright_runs_refused_total{usecase=~\"$usecase\"}[$__range]))",
          "legendFormat": "{{usecase}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Decisions waiting for a person",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pipewright_cases_open{usecase=~\"$usecase\"})",
          "legendFormat": "waiting"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "lineInterpolation": "smooth",
            "fillOpacity": 25
          },
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#F59E0B"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Runs the rules held or refused",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"pipewright-launcher\" && name = \"pipewright.run.start\" && span.pipewright.outcome =~ \"refused|held|submit_failed\" }",
          "limit": 20,
          "spss": 1,
          "tableType": "traces"
        }
      ],
      "transformations": [],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
