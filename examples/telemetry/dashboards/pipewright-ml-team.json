{
  "title": "Pipewright: ML team",
  "uid": "pipewright-ml-team",
  "description": "Your use cases: what started, what the rules refused and why, the decisions waiting for you, and every run with its steps.",
  "tags": [
    "pipewright",
    "opentelemetry",
    "ml"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "title": "Pipewright dashboards",
      "type": "dashboards",
      "tags": [
        "pipewright"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "hide": 0
      },
      {
        "name": "usecase",
        "label": "Use case",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(pipewright_runs_started_total, usecase)",
          "refId": "usecase"
        },
        "definition": "label_values(pipewright_runs_started_total, usecase)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "### Your use cases\nPick a use case above. Each run below opens as a trace: the trigger, the run and every pipeline step, from the orchestrator's own times."
      }
    },
    {
      "type": "stat",
      "title": "Runs started",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(pipewright_runs_started_total{usecase=~\"$usecase\"}[$__range]))) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#00D4FF"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Held or refused",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(pipewright_runs_refused_total{usecase=~\"$usecase\"}[$__range]))) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FBBF24"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Retries absorbed",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(pipewright_runs_deduplicated_total{usecase=~\"$usecase\"}[$__range]))) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#6366F1"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Decisions waiting",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(pipewright_cases_open{usecase=~\"$usecase\"})) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#F59E0B"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Runs started, by pipeline",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pipeline) (increase(pipewright_runs_started_total{usecase=~\"$usecase\"}[$__rate_interval]))",
          "legendFormat": "{{pipeline}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "lineInterpolation": "smooth",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Why runs were held or refused",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(pipewright_runs_refused_total{usecase=~\"$usecase\"}[$__range]))",
          "legendFormat": "{{reason}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Retrain decisions waiting, by use case",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (usecase) (pipewright_cases_open{usecase=~\"$usecase\"})",
          "legendFormat": "{{usecase}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "lineInterpolation": "smooth",
            "fillOpacity": 25
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Runs started, by use case",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (usecase) (increase(pipewright_runs_started_total{usecase=~\"$usecase\"}[$__range]))",
          "legendFormat": "{{usecase}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Latest runs and their steps",
      "description": "",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"pipewright-launcher\" && name = \"pipewright.run\" } | select(span.pipewright.usecase, span.pipewright.pipeline, span.pipewright.state)",
          "limit": 20,
          "spss": 1,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": true,
              "traceName": true,
              "traceIdHidden": true,
              "service.name": true,
              "name": true
            },
            "indexByName": {
              "time": 0,
              "span.pipewright.usecase": 1,
              "pipewright.usecase": 1,
              "span.pipewright.pipeline": 2,
              "pipewright.pipeline": 2,
              "span.pipewright.state": 3,
              "pipewright.state": 3,
              "duration": 4,
              "spanID": 5
            },
            "renameByName": {
              "span.pipewright.usecase": "Use case",
              "span.pipewright.pipeline": "Pipeline",
              "span.pipewright.state": "State",
              "pipewright.usecase": "Use case",
              "pipewright.pipeline": "Pipeline",
              "pipewright.state": "State"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PIPELINE_STATE_FAILED": {
                        "text": "FAILED",
                        "color": "#F87171",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "PIPELINE_STATE_(.*)",
                      "result": {
                        "text": "$1",
                        "color": "#10D98C",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
