{
  "title": "Pipewright: every model run, through one door",
  "uid": "pipewright-overview",
  "description": "The launcher starts every training, scoring and monitoring run, applies the platform's rules first, holds what needs a person and absorbs retries.",
  "tags": [
    "pipewright",
    "opentelemetry",
    "overview"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "title": "Pipewright dashboards",
      "type": "dashboards",
      "tags": [
        "pipewright"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "hide": 0
      },
      {
        "name": "usecase",
        "label": "Use case",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(pipewright_runs_started_total, usecase)",
          "refId": "usecase"
        },
        "definition": "label_values(pipewright_runs_started_total, usecase)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "### Every model run, through one door\nFrom a file landing, a schedule, an API call or a retrain decision, the **Pipewright launcher** starts each run as the team's own identity, after the platform's rules. What needs a person waits for one. **Names and counts only, never data.**"
      }
    },
    {
      "type": "stat",
      "title": "Runs started",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(pipewright_runs_started_total{usecase=~\"$usecase\"}[$__range]))) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#00D4FF"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Held or refused by the rules",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(pipewright_runs_refused_total{usecase=~\"$usecase\"}[$__range]))) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FBBF24"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Retries absorbed",
      "description": "Triggers that mapped to a run already started: the deterministic run ID made the retry harmless.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(pipewright_runs_deduplicated_total{usecase=~\"$usecase\"}[$__range]))) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#6366F1"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Trigger to run, p95",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 15,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pipewright_trigger_latency_seconds_bucket[$__rate_interval])))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#10D98C"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Waiting for a person",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(pipewright_cases_open{usecase=~\"$usecase\"})) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#F59E0B"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Runs started per use case",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (usecase) (increase(pipewright_runs_started_total{usecase=~\"$usecase\"}[$__rate_interval]))",
          "legendFormat": "{{usecase}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "lineInterpolation": "smooth",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "How runs start",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (trigger) (increase(pipewright_runs_started_total{usecase=~\"$usecase\"}[$__rate_interval]))",
          "legendFormat": "{{trigger}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Recent runs: open one to see the trigger, the run and every step",
      "description": "",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"pipewright-launcher\" && name = \"pipewright.run\" } | select(span.pipewright.usecase, span.pipewright.pipeline, span.pipewright.state)",
          "limit": 20,
          "spss": 1,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": true,
              "traceName": true,
              "traceIdHidden": true,
              "service.name": true,
              "name": true
            },
            "indexByName": {
              "time": 0,
              "span.pipewright.usecase": 1,
              "pipewright.usecase": 1,
              "span.pipewright.pipeline": 2,
              "pipewright.pipeline": 2,
              "span.pipewright.state": 3,
              "pipewright.state": 3,
              "duration": 4,
              "spanID": 5
            },
            "renameByName": {
              "span.pipewright.usecase": "Use case",
              "span.pipewright.pipeline": "Pipeline",
              "span.pipewright.state": "State",
              "pipewright.usecase": "Use case",
              "pipewright.pipeline": "Pipeline",
              "pipewright.state": "State"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PIPELINE_STATE_FAILED": {
                        "text": "FAILED",
                        "color": "#F87171",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "PIPELINE_STATE_(.*)",
                      "result": {
                        "text": "$1",
                        "color": "#10D98C",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
