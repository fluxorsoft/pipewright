{
  "title": "Pipewright: SRE and platform",
  "uid": "pipewright-sre",
  "description": "Is the launcher healthy? How fast triggers become runs, which scheduled checks fail, how much the rules refuse and how many retries the run IDs absorb.",
  "tags": [
    "pipewright",
    "opentelemetry",
    "sre",
    "platform"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "title": "Pipewright dashboards",
      "type": "dashboards",
      "tags": [
        "pipewright"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "hide": 0
      },
      {
        "name": "usecase",
        "label": "Use case",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(pipewright_runs_started_total, usecase)",
          "refId": "usecase"
        },
        "definition": "label_values(pipewright_runs_started_total, usecase)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "### Launcher health\nThe launcher is Pipewright's one long-running service: every trigger passes through it. Watch how fast triggers become runs, the scheduled checks, and the share of triggers refused."
      }
    },
    {
      "type": "stat",
      "title": "Trigger to run, p50",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(pipewright_trigger_latency_seconds_bucket[$__rate_interval])))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#10D98C"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Trigger to run, p95",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pipewright_trigger_latency_seconds_bucket[$__rate_interval])))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FBBF24"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Trigger to run, p99",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pipewright_trigger_latency_seconds_bucket[$__rate_interval])))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#F87171"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Failed scheduled checks",
      "description": "",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(pipewright_tick_failures_total[$__range]))) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#F87171"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Trigger to run, by trigger (p95)",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, trigger) (rate(pipewright_trigger_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{trigger}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "lineInterpolation": "smooth",
            "fillOpacity": 25
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "heatmap",
      "title": "Trigger to run: distribution",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(pipewright_trigger_latency_seconds_bucket[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "scheme": "Turbo",
          "mode": "scheme"
        },
        "cellGap": 1,
        "legend": {
          "show": true
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Refused share of triggers",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pipewright_runs_refused_total{usecase=~\"$usecase\"}[$__rate_interval])) / (sum(increase(pipewright_runs_started_total{usecase=~\"$usecase\"}[$__rate_interval])) + sum(increase(pipewright_runs_refused_total{usecase=~\"$usecase\"}[$__rate_interval])))",
          "legendFormat": "refused"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "lineInterpolation": "smooth",
            "fillOpacity": 25
          },
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#FBBF24"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Retries absorbed",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (trigger) (increase(pipewright_runs_deduplicated_total{usecase=~\"$usecase\"}[$__rate_interval]))",
          "legendFormat": "{{trigger}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "lineInterpolation": "smooth",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Failed scheduled checks, by check",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (check) (increase(pipewright_tick_failures_total[$__rate_interval]))",
          "legendFormat": "{{check}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "lineInterpolation": "smooth",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#F87171"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Failed runs",
      "description": "",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"pipewright-launcher\" && name = \"pipewright.run\" && status = error } | select(span.pipewright.usecase, span.pipewright.pipeline, span.pipewright.state)",
          "limit": 20,
          "spss": 1,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": true,
              "traceName": true,
              "traceIdHidden": true,
              "service.name": true,
              "name": true
            },
            "indexByName": {
              "time": 0,
              "span.pipewright.usecase": 1,
              "pipewright.usecase": 1,
              "span.pipewright.pipeline": 2,
              "pipewright.pipeline": 2,
              "span.pipewright.state": 3,
              "pipewright.state": 3,
              "duration": 4,
              "spanID": 5
            },
            "renameByName": {
              "span.pipewright.usecase": "Use case",
              "span.pipewright.pipeline": "Pipeline",
              "span.pipewright.state": "State",
              "pipewright.usecase": "Use case",
              "pipewright.pipeline": "Pipeline",
              "pipewright.state": "State"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PIPELINE_STATE_FAILED": {
                        "text": "FAILED",
                        "color": "#F87171",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "PIPELINE_STATE_(.*)",
                      "result": {
                        "text": "$1",
                        "color": "#10D98C",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Slow runs (over 10 minutes)",
      "description": "",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"pipewright-launcher\" && name = \"pipewright.run\" && duration > 10m } | select(span.pipewright.usecase, span.pipewright.pipeline, span.pipewright.state)",
          "limit": 20,
          "spss": 1,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": true,
              "traceName": true,
              "traceIdHidden": true,
              "service.name": true,
              "name": true
            },
            "indexByName": {
              "time": 0,
              "span.pipewright.usecase": 1,
              "pipewright.usecase": 1,
              "span.pipewright.pipeline": 2,
              "pipewright.pipeline": 2,
              "span.pipewright.state": 3,
              "pipewright.state": 3,
              "duration": 4,
              "spanID": 5
            },
            "renameByName": {
              "span.pipewright.usecase": "Use case",
              "span.pipewright.pipeline": "Pipeline",
              "span.pipewright.state": "State",
              "pipewright.usecase": "Use case",
              "pipewright.pipeline": "Pipeline",
              "pipewright.state": "State"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PIPELINE_STATE_FAILED": {
                        "text": "FAILED",
                        "color": "#F87171",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "PIPELINE_STATE_(.*)",
                      "result": {
                        "text": "$1",
                        "color": "#10D98C",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
