# Pipewright component image (KFP containerized Python components). Generated build context:
#   requirements.txt   the use case's component requirements
#   components/        the use case's component modules
#   kfp_config.ini     generated by Pipewright: maps each component function to its file
# Every pipeline step runs: python3 -m kfp.dsl.executor_main --function_to_execute <fn>
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app/components

COPY requirements.txt ./requirements.txt
# PIPEWRIGHT_BUILD_CA_BUNDLE (a TLS-inspecting proxy's CA) arrives as a build secret: used by pip, never stored.
RUN --mount=type=secret,id=pip_ca,required=false \
    if [ -s /run/secrets/pip_ca ]; then export PIP_CERT=/run/secrets/pip_ca; fi; \
    pip install -r requirements.txt

COPY components/ ./
COPY kfp_config.ini ./

ARG RELEASE_ID=unknown
ARG USECASE=unknown
ENV PIPEWRIGHT_RELEASE=${RELEASE_ID}
LABEL dev.pipewright.usecase="${USECASE}" \
      dev.pipewright.release="${RELEASE_ID}"

# Fail the build if any listed component cannot be imported.
RUN python -c "import importlib, kfp.dsl.kfp_config as c; [importlib.import_module(str(p)[:-3]) for p in c.KFPConfig().get_components().values()]"
