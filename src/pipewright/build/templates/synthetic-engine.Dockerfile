# Pipewright synthetic engine image: the generate step of the synthetic pipeline (FR-49). Generated build context:
#   requirements.txt   the engine (MOSTLY AI SDK local mode on CPU PyTorch), kfp, plus synthetic.requirements
#   components/        synthetic_steps.py, pipewright_runtime.py, pipewright_synthetic/ (from Pipewright)
#   kfp_config.ini     generated by Pipewright: maps each component function to its file
# No network at run time: Hugging Face libraries are offline, and the engine downloads nothing for tabular data.
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1

WORKDIR /app/components

COPY requirements.txt ./requirements.txt
# PIPEWRIGHT_BUILD_CA_BUNDLE (a TLS-inspecting proxy's CA) arrives as a build secret: used by pip, never stored.
# One resolution with the CPU index first: otherwise PyTorch comes with CUDA (3.5 GB of libraries no CPU node uses).
RUN --mount=type=secret,id=pip_ca,required=false \
    if [ -s /run/secrets/pip_ca ]; then export PIP_CERT=/run/secrets/pip_ca; fi; \
    pip install -r requirements.txt && \
    if pip list 2>/dev/null | grep -qi "^nvidia-"; then echo "CUDA libraries in a CPU image"; exit 1; fi && \
    pip freeze > /app/packages.txt

COPY components/ ./
COPY kfp_config.ini ./

ARG RELEASE_ID=unknown
ARG USECASE=unknown
ENV PIPEWRIGHT_RELEASE=${RELEASE_ID}
LABEL dev.pipewright.usecase="${USECASE}" \
      dev.pipewright.release="${RELEASE_ID}" \
      dev.pipewright.component="synthetic-engine"

RUN python -c "import synthetic_steps, pipewright_runtime, pipewright_synthetic.engines, mostlyai.sdk"
