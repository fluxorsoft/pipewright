# Pipewright synthetic evaluation image: every step of the synthetic pipeline but generate (FR-49). Generated build
# context:
#   requirements.txt   Anonymeter, scikit-learn, pandas, BigQuery and Cloud Storage clients, kfp
#   components/        synthetic_steps.py, pipewright_runtime.py, pipewright_synthetic/ (from Pipewright)
#   kfp_config.ini     generated by Pipewright: maps each component function to its file
# Nothing from the SDV stack: fidelity is computed by pipewright_synthetic.evaluation.
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    NUMBA_CACHE_DIR=/tmp/numba

WORKDIR /app/components

COPY requirements.txt ./requirements.txt
RUN --mount=type=secret,id=pip_ca,required=false \
    if [ -s /run/secrets/pip_ca ]; then export PIP_CERT=/run/secrets/pip_ca; fi; \
    pip install -r requirements.txt && pip freeze > /app/packages.txt

COPY components/ ./
COPY kfp_config.ini ./

ARG RELEASE_ID=unknown
ARG USECASE=unknown
ENV PIPEWRIGHT_RELEASE=${RELEASE_ID}
LABEL dev.pipewright.usecase="${USECASE}" \
      dev.pipewright.release="${RELEASE_ID}" \
      dev.pipewright.component="synthetic-evaluation"

RUN python -c "import synthetic_steps, pipewright_runtime, pipewright_synthetic.evaluation, anonymeter, sklearn"
