{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipewright.dev/schemas/v1/usecase.schema.json",
  "title": "Pipewright UseCase (ML persona). Validated after include files and environment files are merged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "pipewright/v1" },
    "kind": { "const": "UseCase" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "owner": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "objective": { "type": "string" },
        "contacts": { "type": "array", "items": { "$ref": "#/$defs/principal" } },
        "labels": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
          "additionalProperties": { "type": "string", "pattern": "^[a-z0-9_-]{0,63}$" }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "model"],
      "anyOf": [{ "required": ["pipeline"] }, { "required": ["pipelines"] }, { "required": ["bqml"] }],
      "if": { "not": { "required": ["bqml"] } },
      "then": { "required": ["components"] },
      "properties": {
        "tenant": { "$ref": "#/$defs/name" },
        "run_in": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" },
          "description": "The environments this use case runs in (Pipewright 1.1). Left out: every environment"
        },
        "include": {
          "type": "array",
          "items": { "type": "string", "pattern": "\\.ya?ml$" },
          "description": "Glob patterns (relative to the use case folder) of files holding spec sections"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runner_service_account": { "type": "string", "minLength": 1 },
            "bigquery_dataset": { "type": "string", "minLength": 1 },
            "landing_prefix": { "type": "string", "minLength": 1 },
            "outputs_uri": { "type": "string", "pattern": "^gs://[^/]+/.*/$" }
          }
        },
        "pipeline": { "$ref": "#/$defs/pipeline_ref", "description": "Shorthand for pipelines.training" },
        "pipelines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["training"],
          "properties": {
            "training": { "$ref": "#/$defs/pipeline_ref" },
            "inference": { "$ref": "#/$defs/pipeline_ref" }
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dir"],
          "properties": {
            "dir": { "type": "string", "minLength": 1 },
            "requirements": { "type": "string", "minLength": 1 },
            "ray_requirements": { "type": "string", "minLength": 1 }
          }
        },
        "framework": { "enum": ["pytorch"] },
        "triggers": { "$ref": "#/$defs/triggers" },
        "parameters": { "$ref": "#/$defs/parameters" },
        "resources_per_step": { "$ref": "#/$defs/steps", "description": "Older name for steps" },
        "steps": { "$ref": "#/$defs/steps" },
        "data": { "$ref": "#/$defs/data" },
        "features": { "$ref": "#/$defs/features" },
        "training": { "$ref": "#/$defs/training" },
        "evaluation": { "$ref": "#/$defs/evaluation" },
        "explainability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "method": { "enum": ["permutation"] },
            "top_k": { "type": "integer", "minimum": 1 }
          }
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "set_default": { "enum": ["on_approval", "manual"] } }
        },
        "model_card": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intended_use": { "type": "string" },
            "out_of_scope": { "type": "string" },
            "limitations": { "type": "string" },
            "ethical_considerations": { "type": "string" }
          }
        },
        "inference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "output_table": { "type": "string", "minLength": 1 },
            "decision_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "monitoring": { "$ref": "#/$defs/monitoring" },
        "retraining": { "$ref": "#/$defs/retraining" },
        "synthetic": { "$ref": "#/$defs/synthetic" },
        "bqml": { "$ref": "#/$defs/bqml" },
        "data_protection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "personal_data_columns": { "type": "array", "items": { "type": "string" } },
            "erasure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key_column"],
              "properties": { "key_column": { "type": "string" } }
            }
          }
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "on_release": { "type": "boolean", "description": "pipewright release runs tests.command first and stops on a non-zero exit (default false)" },
            "environment": { "enum": ["pipewright", "components"], "description": "where tests.command runs: Pipewright's own interpreter (the default) or a cached virtual environment with the components' requirements" }
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "store": { "enum": ["bigquery", "gcs", "both"], "description": "where tables are written (default bigquery)" },
            "gcs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "format": { "enum": ["parquet"] },
                "external_tables": { "type": "boolean", "description": "BigQuery external tables over the files (store gcs)" }
              }
            },
            "bigquery": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tables": {
                  "type": "object",
                  "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,1023}$" },
                  "additionalProperties": {
                    "oneOf": [
                      { "type": "string", "pattern": "\\.json$" },
                      { "$ref": "#/$defs/table" }
                    ]
                  }
                },
                "retention_days": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
            "promotion": { "enum": ["model", "retrain"] },
            "serving": { "$ref": "#/$defs/serving" }
          }
        },
        "approvals": { "$ref": "#/$defs/approvals" },
        "features_store": { "type": "null", "description": "Reserved for v1.x" },
        "environments": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/overrides" }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$" },
    "principal": { "type": "string", "pattern": "^(group|user|serviceAccount):.+$" },
    "approval_mode": { "enum": ["manual", "auto"] },
    "pipeline_name": { "enum": ["training", "inference", "synthetic"], "description": "synthetic: the pipeline Pipewright provides when synthetic.enabled" },
    "pipeline_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "function"],
      "properties": {
        "file": { "type": "string", "pattern": "\\.py$" },
        "function": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "landing": {
          "type": ["object", "null"],
          "description": "null turns file landing off (e.g. in one environment)",
          "additionalProperties": false,
          "required": ["suffixes"],
          "properties": {
            "suffixes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9.]+$" }
            },
            "pipeline": { "$ref": "#/$defs/pipeline_name" }
          }
        },
        "schedules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "cron", "timezone"],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "cron": { "type": "string", "minLength": 1 },
              "timezone": { "type": "string", "minLength": 1 },
              "source_uri": { "type": "string", "minLength": 1 },
              "pipeline": { "$ref": "#/$defs/pipeline_name" }
            }
          }
        },
        "api": { "type": "boolean" }
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cpu": { "type": ["number", "string"] },
          "memory": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?[MG]$" },
          "gpu": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "count"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 1 }
            }
          },
          "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
          "cache": { "type": "boolean" },
          "ray": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "head_machine": { "type": "string", "minLength": 1 },
              "worker_machine": { "type": "string", "minLength": 1 },
              "workers": { "type": "integer", "minimum": 0 },
              "accelerator": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "count"],
                "properties": {
                  "type": { "type": "string", "minLength": 1 },
                  "count": { "type": "integer", "minimum": 1 }
                }
              },
              "max_minutes": { "type": "integer", "minimum": 5 }
            }
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "integer", "float", "boolean", "date", "timestamp"] },
        "required": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "allowed": { "type": "array" },
        "max_null_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns"],
          "properties": {
            "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column" } },
            "min_rows": { "type": "integer", "minimum": 1 },
            "max_null_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
            "unique": { "type": "array", "items": { "type": "string" } },
            "allow_extra_columns": { "type": "boolean" }
          }
        },
        "label": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "column": { "type": "string" },
            "values": { "type": "array" },
            "positive": {},
            "task": { "enum": ["binary", "multiclass", "regression", "clustering", "decomposition", "forecast"] }
          }
        },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": { "enum": ["random", "stratified", "time"] },
            "time_column": { "type": "string" },
            "test_fraction": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "validation_fraction": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
            "seed": { "type": "integer" }
          }
        },
        "snapshot_table": { "type": "string", "minLength": 1 },
        "label_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "time_column", "window_days"],
          "properties": {
            "table": { "type": "string", "pattern": "^bq://" },
            "key": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "time_column": { "type": "string" },
            "window_days": { "type": "integer", "minimum": 1 },
            "cutoff_column": { "type": "string" }
          }
        },
        "features_from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity", "sources"],
          "properties": {
            "entity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["columns", "time_column"],
              "properties": {
                "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "time_column": { "type": "string" }
              }
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["features"],
                "properties": {
                  "table": { "type": "string", "pattern": "^bq://" },
                  "feature_group": { "type": "string" },
                  "project": { "type": "string" },
                  "region": { "type": "string" },
                  "entity_columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "time_column": { "type": "string" },
                  "features": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "prefix": { "type": "string" },
                  "online_view": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,59}$", "description": "the feature view online serving reads this source from (default: the feature group's name)" }
                }
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hyperparameters": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["number", "string", "boolean"] }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hyperparameters": { "$ref": "#/$defs/hyperparameters" },
        "seed": { "type": "integer" },
        "experiment": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" } }
        },
        "tuning": { "$ref": "#/$defs/tuning" }
      }
    },
    "tuning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "metric": { "type": "string" },
        "goal": { "enum": ["maximize", "minimize"] },
        "max_trials": { "type": "integer", "minimum": 1, "maximum": 50 },
        "parallel_trials": { "type": "integer", "minimum": 1, "maximum": 20 },
        "search_space": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "enum": ["double", "integer", "discrete", "categorical"] },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "values": { "type": "array", "minItems": 1 },
              "scale": { "enum": ["linear", "log"] }
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric"],
      "properties": {
        "metric": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "per_series": { "type": "boolean", "description": "forecasts: every series (bqml.forecast.id_columns) must pass, not only the overall value (Pipewright 1.2)" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_metric": { "type": "string" },
        "decision_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "metrics": { "type": "array", "items": { "type": "string" } },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "champion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "metric": { "type": "string" },
            "min_improvement": { "type": "number" }
          }
        },
        "slices": { "type": "array", "items": { "type": "string" } },
        "slice_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "max_gap"],
            "properties": {
              "metric": { "type": "string" },
              "max_gap": { "type": "number", "minimum": 0 },
              "min_rows": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "fairness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attributes"],
          "description": "bias measures per attribute on the test set, gated like other metrics (Pipewright 1.1)",
          "properties": {
            "attributes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "metrics": {
              "type": "array",
              "items": { "enum": ["demographic_parity_difference", "equal_opportunity_difference", "equalized_odds_difference"] }
            },
            "gates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["metric", "max"],
                "properties": {
                  "metric": { "enum": ["demographic_parity_difference", "equal_opportunity_difference", "equalized_odds_difference"] },
                  "max": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            },
            "min_rows": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "synthetic_engine": {
      "type": "object",
      "properties": {
        "type": { "enum": ["mostlyai", "sdv"], "description": "mostlyai: MOSTLY AI SDK in local mode (default); sdv: only if your team installs SDV (synthetic.requirements) under its own licence" },
        "model": { "type": ["string", "null"], "description": "mostlyai: MOSTLY_AI/Small, Medium or Large; sdv: gaussian_copula, ctgan, tvae or copulagan" },
        "max_training_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "differential_privacy": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["epsilon"],
          "properties": { "epsilon": { "type": "number", "exclusiveMinimum": 0 } },
          "description": "train with a differential privacy budget (mostlyai)"
        },
        "sampling_temperature": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
        "rare_categories": { "enum": ["constant", "sample"] },
        "epochs": { "type": "integer", "minimum": 1 }
      }
    },
    "synthetic_min_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min"],
      "properties": { "min": { "type": "number" } }
    },
    "synthetic_max_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max"],
      "properties": { "max": { "type": "number" } }
    },
    "bqml": {
      "type": "object",
      "additionalProperties": false,
      "description": "BigQuery ML as the training engine: Pipewright provides the training and scoring pipelines (model_type, or import)",
      "properties": {
        "model_type": {
          "enum": ["logistic_reg", "boosted_tree_classifier", "random_forest_classifier", "linear_reg",
                   "boosted_tree_regressor", "random_forest_regressor", "kmeans", "pca", "arima_plus"]
        },
        "forecast": {
          "type": "object",
          "additionalProperties": false,
          "required": ["horizon"],
          "description": "a forecast (data.label.task forecast, Pipewright 1.1): the series is data.label.column over data.split.time_column, one series per id_columns value",
          "properties": {
            "engine": { "enum": ["arima_plus", "ai_forecast"], "description": "arima_plus (CREATE MODEL), or ai_forecast (AI.FORECAST, where policies.bqml.ai_forecast allows it)" },
            "horizon": { "type": "integer", "minimum": 1, "maximum": 10000, "description": "time points scoring forecasts" },
            "id_columns": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
            "confidence_level": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
            "model": { "enum": ["TimesFM 2.5"], "description": "ai_forecast only" },
            "context_window": { "enum": [64, 128, 256, 512, 1024, 2048, 4096, 8192, 15360], "description": "ai_forecast only: the latest points the model reads" }
          }
        },
        "import": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "path", "outputs"],
          "description": "a model trained elsewhere, imported into BigQuery ML instead of trained there (Pipewright 1.1)",
          "properties": {
            "format": { "enum": ["tensorflow", "onnx"] },
            "path": { "type": "string", "pattern": "^gs://.+/\\*$" },
            "outputs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "score": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                "score_index": { "type": "integer", "minimum": 0 },
                "label": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                "prediction": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
              }
            }
          }
        },
        "options": { "type": "object" },
        "transform": { "type": "string", "pattern": "\\.sql$" },
        "prepare": { "type": "string", "pattern": "\\.sql$" },
        "metrics_table": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "a table in outputs.bigquery.tables that gets one row per training run, approved or refused, as the container examples' metrics table does" },
        "contract_on": { "enum": ["prepared", "source"], "description": "the rows the data contract checks: prepared (the default, as in 1.x) or source (as read, before bqml.prepare, as the container path checks them)" },
        "explain": { "type": "boolean" },
        "max_bytes_billed": { "type": "integer", "minimum": 1 }
      }
    },
    "synthetic": {
      "type": "object",
      "additionalProperties": false,
      "description": "synthetic data generation (off unless enabled): an engine learns from real data inside the environment, or rules generate rows from the data contract alone",
      "properties": {
        "enabled": { "type": "boolean" },
        "purpose": { "enum": ["test-data", "sharing"], "description": "sets the default gates: test-data stays in the organisation, sharing leaves it" },
        "tier": { "enum": ["learned", "contract"] },
        "source_uri": { "type": "string", "description": "learned: the data the engine learns from, read point in time like training" },
        "output_table": { "type": "string", "description": "learned: a table in outputs.bigquery.tables" },
        "rows": { "type": ["integer", "null"], "minimum": 1 },
        "holdout_fraction": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.5 },
        "seed": { "type": ["integer", "null"] },
        "engine": { "$ref": "#/$defs/synthetic_engine", "unevaluatedProperties": false },
        "candidates": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/synthetic_engine",
            "required": ["name"],
            "properties": { "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,30}$" } },
            "unevaluatedProperties": false
          },
          "description": "engine variants tried side by side; the best one passing every gate is kept"
        },
        "columns": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["rule"],
            "properties": {
              "rule": { "enum": ["key", "fake", "constant", "drop", "time", "values", "range"] },
              "prefix": { "type": "string" },
              "provider": { "enum": ["email", "name", "phone", "uuid", "text"] },
              "value": {},
              "from": { "type": "string" },
              "to": { "type": "string" },
              "step": { "enum": ["day", "month_end"] },
              "values": { "type": "array", "minItems": 1 },
              "weights": { "type": "array", "items": { "type": "number", "minimum": 0 } },
              "min": { "type": "number" },
              "max": { "type": "number" }
            },
            "additionalProperties": false
          },
          "description": "columns decided by rules, not learned (keys, personal data, time grids)"
        },
        "sensitive_columns": { "type": "array", "items": { "type": "string" } },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fidelity": { "$ref": "#/$defs/synthetic_min_gate" },
            "tstr_drop": { "$ref": "#/$defs/synthetic_max_gate" },
            "exact_copies": { "$ref": "#/$defs/synthetic_max_gate" },
            "dcr_ratio": { "$ref": "#/$defs/synthetic_min_gate" },
            "closer_than_p5": { "$ref": "#/$defs/synthetic_max_gate" },
            "singling_out": { "$ref": "#/$defs/synthetic_max_gate" },
            "linkability": { "$ref": "#/$defs/synthetic_max_gate" },
            "inference": { "$ref": "#/$defs/synthetic_max_gate" }
          },
          "description": "overrides of the purpose's gates; privacy gates may only be made stricter"
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "attacks": { "type": "integer", "minimum": 100, "maximum": 5000 } }
        },
        "requirements": { "type": "string", "description": "extra packages for the synthetic image (e.g. SDV, which your team installs)" },
        "mode": { "enum": ["flat", "relational"], "description": "relational: the entity table and its child tables (feature tables, sequences) learned together" },
        "output_tables": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "relational: each child table's output table (in outputs.bigquery.tables), by child name"
        },
        "sequences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source_uri", "key", "order_by"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
              "source_uri": { "type": "string" },
              "key": { "type": "string" },
              "order_by": { "type": "string" },
              "columns": { "type": "array", "items": { "type": "string" } }
            }
          },
          "description": "relational: event tables per entity (transactions, sessions), generated in order with the entity table"
        }
      }
    },
    "retraining": {
      "type": "object",
      "additionalProperties": false,
      "description": "what drift or a performance drop does: off (alerts only), propose (a person decides), candidate (trains a candidate, never promotes)",
      "properties": {
        "mode": { "enum": ["off", "propose", "candidate", false], "description": "YAML reads an unquoted off as false: both mean off" },
        "enabled": { "type": "boolean", "description": "older switch: true means mode propose, false means off" },
        "when": { "type": "array", "items": { "enum": ["schedule", "drift", "performance"] }, "description": "not `on`: YAML reads on as true" },
        "cooldown_days": { "type": "integer", "minimum": 0, "description": "after an approved retrain, new alerts are recorded but open no case" },
        "source_uri": { "type": "string", "description": "default training data for an approved retrain (an approver may choose another)" },
        "loop": {
          "type": "object",
          "additionalProperties": false,
          "description": "the closed retrain loop (FR-48): an approved case here trains in the environment releases come from (promotion.from), not here",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notify": { "type": "array", "items": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"}, "description": "emailed the case summary and ID; email never approves" },
            "publish": { "type": "boolean", "description": "also deliver decision events to the tenant's decision feed (a platform-provisioned subscription)" },
            "escalate_after_days": { "type": "integer", "minimum": 1 },
            "escalate_notify": { "type": "array", "items": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"} },
            "digest": { "type": "boolean", "description": "weekly summary of open cases and decisions" }
          }
        },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$" },
                          "description": "approver groups registered by the platform (manifest approver_groups); one approval from each" },
            "separate_from_requester": { "type": "boolean" }
          }
        },
        "snooze": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_days": { "type": "integer", "minimum": 1, "maximum": 365 },
            "reopen_when_worse_by": { "type": "number", "exclusiveMinimum": 0, "description": "re-open a snoozed or declined case at once when the worst PSI rises by this much" }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alerts": {
          "type": "object",
          "additionalProperties": false,
          "description": "email notifications for Pipewright events (`pipewright alerts sync`)",
          "properties": {
            "notify": { "type": "array", "items": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
                        "description": "email addresses, including distribution lists" },
            "events": { "type": "array", "minItems": 1, "items": { "enum": ["monitoring.alert", "retrain.requested",
                        "training.rejected", "training.evaluated", "model.registered", "run.failed"] } },
            "severity": { "enum": ["CRITICAL", "ERROR", "WARNING"] }
          }
        },
        "drift": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "method": { "enum": ["psi"] },
            "threshold": { "type": "number", "exclusiveMinimum": 0 },
            "features": { "type": "array", "items": { "type": "string" } }
          }
        },
        "prediction_drift": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "threshold": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "required": ["table", "key", "label"],
              "properties": {
                "table": { "type": "string" },
                "key": { "type": "string" },
                "label": { "type": "string" },
                "time_column": { "type": "string", "description": "the outcome's cut-off column: outcomes are joined to the scores made for that cut-off (the scores' scored_for), never to a later or earlier score (Pipewright 1.2)" }
              }
            },
            "metric": { "type": "string" },
            "min": { "type": "number" }
          }
        },
        "output_table": { "type": "string" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": { "type": "string", "pattern": "\\.json$" },
        "partition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "type"],
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "type": { "enum": ["HOUR", "DAY", "MONTH", "YEAR"] }
          }
        },
        "cluster": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
        "description": { "type": "string" }
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "target": { "enum": ["vertex", "kserve"] },
        "features": { "enum": ["request", "online"], "description": "online: the endpoint takes entity IDs and reads the features from the tenant's online store (Pipewright 1.1); request (the default): callers send the features" },
        "machine": { "type": "string", "minLength": 1 },
        "replicas": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "canary_percent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "accelerator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "description": "a GPU per replica (Pipewright 1.2), within the environment's policies.accelerators.serving; machine must take it (e.g. g2-standard-8 with NVIDIA_L4)",
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1 }
          }
        },
        "scale_to_zero": { "type": "boolean", "description": "with replicas.min 0: an idle endpoint runs no replica, and the first request after a quiet spell waits for one to start (Pipewright 1.2; Agent Platform preview)" },
        "fill_missing": { "type": "boolean", "description": "the endpoint fills an empty feature with its training median, as batch scoring does (Pipewright 1.2, default true); false: it answers an error naming the feature" }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "promote_model": { "$ref": "#/$defs/approval_mode" },
        "deploy_model": { "$ref": "#/$defs/approval_mode" },
        "approvers": { "type": "array", "items": { "$ref": "#/$defs/principal" } }
      }
    },
    "overrides": {
      "description": "Keys that may vary per environment. Everything else is fixed so promotion compares like with like.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameters": { "$ref": "#/$defs/parameters" },
        "resources_per_step": { "$ref": "#/$defs/steps" },
        "steps": { "$ref": "#/$defs/steps" },
        "triggers": { "$ref": "#/$defs/triggers" },
        "training": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hyperparameters": { "$ref": "#/$defs/hyperparameters" },
            "tuning": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "max_trials": { "type": "integer", "minimum": 1, "maximum": 50 },
                "parallel_trials": { "type": "integer", "minimum": 1, "maximum": 20 }
              }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "serving": { "$ref": "#/$defs/serving" } }
        },
        "approvals": { "$ref": "#/$defs/approvals" },
        "synthetic": {
          "type": "object",
          "additionalProperties": false,
          "description": "per environment: switch synthetic data on or off, how many rows, how long to train (gates and privacy stay fixed)",
          "properties": {
            "enabled": { "type": "boolean" },
            "rows": { "type": ["integer", "null"], "minimum": 1 },
            "engine": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "max_training_minutes": { "type": "number", "exclusiveMinimum": 0 } }
            }
          }
        },
        "retraining": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["off", "propose", "candidate", false], "description": "YAML reads an unquoted off as false: both mean off" },
            "loop": { "$ref": "#/$defs/retraining/properties/loop" },
            "decisions": { "$ref": "#/$defs/retraining/properties/decisions" },
            "approvals": { "$ref": "#/$defs/retraining/properties/approvals" },
            "snooze": { "$ref": "#/$defs/retraining/properties/snooze" }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "alerts": {
          "type": "object",
          "additionalProperties": false,
          "description": "email notifications for Pipewright events (`pipewright alerts sync`)",
          "properties": {
            "notify": { "type": "array", "items": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
                        "description": "email addresses, including distribution lists" },
            "events": { "type": "array", "minItems": 1, "items": { "enum": ["monitoring.alert", "retrain.requested",
                        "training.rejected", "training.evaluated", "model.registered", "run.failed"] } },
            "severity": { "enum": ["CRITICAL", "ERROR", "WARNING"] }
          }
        } }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bigquery": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "retention_days": { "type": "integer", "minimum": 1 } }
            }
          }
        }
      }
    }
  }
}
