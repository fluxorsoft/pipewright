{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipewright.dev/schemas/v1/manifest.schema.json",
  "title": "Pipewright environment manifest (written by the platform side, read by the ML side)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "environment",
    "blueprint",
    "orchestrator",
    "project",
    "region",
    "artifact_registry",
    "artifacts_bucket",
    "landing_bucket",
    "launcher",
    "tenants"
  ],
  "properties": {
    "apiVersion": {
      "const": "pipewright/v1"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "blueprint": {
      "type": "string",
      "pattern": "^(poc|private-managed|private-gke)(@[0-9]+\\.[0-9]+\\.[0-9]+)?$"
    },
    "orchestrator": {
      "enum": [
        "vertex",
        "kfp"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "artifact_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docker",
        "kfp"
      ],
      "properties": {
        "docker": {
          "type": "string",
          "minLength": 1
        },
        "kfp": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string"
        }
      }
    },
    "artifacts_bucket": {
      "type": "string",
      "minLength": 1
    },
    "landing_bucket": {
      "type": "string",
      "minLength": 1
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_account"
      ],
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "service": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_account": {
          "type": "string",
          "minLength": 1
        },
        "subscription": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_requests_topic": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^projects/[^/]+/topics/[^/]+$",
          "description": "Pub/Sub topic for run requests from inside the perimeter (pushed to the launcher's /pubsub/run); used instead of calling /run when set"
        },
        "runtime": {
          "enum": [
            "cloud_run",
            "gke"
          ],
          "description": "cloud_run (default): the launcher is a Cloud Run service fed by push subscriptions; gke: a Deployment in the cluster (private-gke) that pulls the same subscriptions"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "runtime gke: the launcher's namespace"
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          },
          "description": "every name the launcher answers to (ID token audiences): its Cloud Run URL and its name in the cluster, so releases built under either runtime keep working"
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deploy_model": {
          "enum": [
            "manual",
            "auto"
          ]
        },
        "promote_model": {
          "enum": [
            "manual",
            "auto"
          ]
        },
        "retraining": {
          "type": "object",
          "additionalProperties": false,
          "description": "platform limits on retrain decisions in this environment",
          "properties": {
            "allowed_modes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "off",
                  "propose",
                  "candidate"
                ]
              }
            },
            "required_approvers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "description": "approver groups every use case must include (e.g. model risk)"
            },
            "max_snooze_days": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "tenants": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,30}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runner_service_account",
          "bigquery_dataset"
        ],
        "properties": {
          "runner_service_account": {
            "type": "string",
            "minLength": 1
          },
          "bigquery_dataset": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,1023}$"
          },
          "landing_prefix": {
            "type": [
              "string",
              "null"
            ]
          },
          "online_serving": {
            "type": "boolean"
          },
          "namespace": {
            "type": [
              "string",
              "null"
            ]
          },
          "outputs_uri": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^gs://[^/]+/.*/$",
            "description": "where use cases of this tenant may write GCS outputs (ends with /)"
          },
          "decision_feed": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^projects/[^/]+/subscriptions/[^/]+$",
            "description": "subscription with this tenant's retrain decision events (use cases opt in with retraining.decisions.publish)"
          },
          "kubernetes_service_account": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "description": "orchestrator kfp: the Kubernetes service account this tenant's runs and Ray clusters use (Workload Identity binds it to the runner)"
          },
          "ray": {
            "anyOf": [
              {
                "$ref": "#/$defs/ray"
              },
              {
                "type": "null"
              }
            ],
            "description": "this tenant's Ray settings, over the environment's"
          },
          "features": {
            "anyOf": [
              {
                "$ref": "#/$defs/tenant_features"
              },
              {
                "type": "null"
              }
            ],
            "description": "the feature datasets this tenant's use cases may read (data.features_from)"
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events_topic": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^projects/[^/]+/topics/[^/]+$",
          "description": "Pub/Sub topic for Pipewright lifecycle events"
        },
        "log_sinks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "informational: where the platform routes logs (e.g. dynatrace)"
        },
        "otlp_endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_dataset": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,1023}$",
          "description": "BigQuery dataset with lifecycle events and audit logs (evidence packs)"
        },
        "evidence_uri": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^gs://[^/]+/.*/$",
          "description": "write-once location for evidence packs (ends with /)"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "description": "private profiles: applied by Pipewright to every pipeline job, model and endpoint it creates",
      "properties": {
        "kms_key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^projects/[^/]+/locations/[^/]+/keyRings/[^/]+/cryptoKeys/[^/]+$",
          "description": "CMEK key for pipeline jobs, models and endpoints"
        },
        "network": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^projects/[0-9]+/global/networks/[^/]+$",
          "description": "VPC that pipeline jobs peer with (projects/<number>/global/networks/<name>)"
        },
        "reserved_ip_ranges": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Private Services Access ranges for pipeline jobs"
        },
        "perimeter": {
          "type": [
            "string",
            "null"
          ],
          "description": "informational: the VPC Service Controls perimeter"
        },
        "bigquery_kms_key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^projects/[^/]+/locations/[^/]+/keyRings/[^/]+/cryptoKeys/[^/]+$",
          "description": "CMEK key for BigQuery query results (required when the CMEK organization policy covers BigQuery)"
        }
      }
    },
    "approver_groups": {
      "type": "object",
      "description": "registered approver groups: a member approves by publishing to the group's topic, so IAM on the topic decides who belongs (any Google group, user or service account)",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,30}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "subscription"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "pattern": "^projects/[^/]+/topics/[^/]+$"
          },
          "subscription": {
            "type": "string",
            "pattern": "^projects/[^/]+/subscriptions/[^/]+$",
            "description": "push subscription to the launcher's /retraining/decide"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "ray": {
      "anyOf": [
        {
          "$ref": "#/$defs/ray"
        },
        {
          "type": "null"
        }
      ]
    },
    "features": {
      "anyOf": [
        {
          "$ref": "#/$defs/features"
        },
        {
          "type": "null"
        }
      ]
    },
    "requires": {
      "type": "string",
      "description": "the Pipewright versions this manifest needs, as a version specifier (for example \">=0.5\"); older versions refuse it with a clear message"
    },
    "kubernetes": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "endpoint"
      ],
      "description": "orchestrator kfp (private-gke): the GKE cluster's Kubernetes API, called as the caller's Google identity",
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^https://"
        },
        "dns_endpoint": {
          "type": [
            "string",
            "null"
          ],
          "description": "the cluster's DNS endpoint (a host name, IAM authorized): for callers outside the VPC, such as a Fleet View collector"
        },
        "ca_certificate": {
          "type": [
            "string",
            "null"
          ],
          "description": "the cluster's CA certificate, base64 PEM"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "where Kubeflow Pipelines runs and Ray clusters run"
        },
        "cluster": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^projects/[^/]+/locations/[^/]+/clusters/[^/]+$",
          "description": "the GKE cluster's resource name (evidence reads its node disk keys, secrets key and network)"
        }
      }
    },
    "schedules": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "where use cases' schedules (triggers.schedules) run; without it: Cloud Scheduler jobs that call the launcher",
      "properties": {
        "backend": {
          "enum": [
            "cloud_scheduler",
            "kubernetes"
          ],
          "description": "cloud_scheduler: a Cloud Scheduler job per schedule; kubernetes: a CronJob per schedule in the cluster (private-gke), which publishes the run request to launcher.run_requests_topic"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "kubernetes: the namespace for the CronJobs (only the scheduler's service account is there)"
        },
        "service_account": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "kubernetes: the Kubernetes service account the CronJobs run as (bound to an identity that may only publish run requests)"
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "description": "kubernetes: the image the CronJobs run (one with Pipewright: the launcher image), pinned by digest"
        },
        "run_as_user": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "kubernetes: the user ID the CronJobs run as (the image's non-root user; default 10001, the launcher image's)"
        }
      }
    },
    "kserve": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "private-gke: KServe for use cases with model.serving.target kserve",
      "properties": {
        "mirror": {
          "type": [
            "string",
            "null"
          ],
          "description": "image mirror in the environment's registry (serving images from elsewhere are pulled from it)"
        },
        "service_account": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "the Kubernetes service account model servers run as (bound to the tenant's read-only serving identity)"
        },
        "namespaces": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "description": "tenant => namespace of its InferenceServices"
        },
        "exposure": {
          "enum": [
            "cluster",
            "internal_lb"
          ],
          "description": "cluster: reached inside the cluster; internal_lb: also an internal load balancer in the VPC"
        }
      }
    }
  },
  "$defs": {
    "ray": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ray on Vertex AI clusters for use cases' Ray steps (optional; without it: a cluster per run, the runner identity, a prebuilt image, public endpoint, small limits)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "false: no Ray clusters in this environment (or for this tenant)"
        },
        "mode": {
          "enum": [
            "per_run"
          ],
          "description": "per_run: a cluster per Ray step of a run, created and deleted by the launcher (standing clusters are planned)"
        },
        "ray_version": {
          "enum": [
            "2.33",
            "2.42",
            "2.47"
          ]
        },
        "python_version": {
          "enum": [
            "3.10",
            "3.11"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "description": "base image for use cases' Ray images (default: the prebuilt Ray on Vertex AI image)"
        },
        "network_attachment": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^projects/[^/]+/regions/[^/]+/networkAttachments/[^/]+$",
          "description": "Private Service Connect interface for clusters (private environments)"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "description": "what a use case's Ray step may ask for",
          "properties": {
            "max_workers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "most worker nodes in one cluster"
            },
            "machines": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "machine types allowed for head and worker nodes"
            },
            "accelerators": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "accelerator types allowed (empty: none)"
            },
            "max_minutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 1440,
              "description": "longest a cluster may live; cleanup removes it after this plus a grace period"
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "description": "Feature tables for use cases' data.features_from (optional; without it any table the runner can read)",
      "properties": {
        "required": {
          "type": "boolean",
          "description": "models in this environment must take every feature from data.features_from"
        }
      }
    },
    "tenant_features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{4,61}[a-z0-9]\\.[A-Za-z0-9_]{1,1024}$"
          },
          "description": "project.dataset of each feature dataset the tenant may read; feature tables elsewhere are refused"
        }
      }
    }
  }
}
