<mxfile host="app.diagrams.net"><diagram id="Pipewright on private GKE" name="Pipewright on private GKE"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1320" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:22px"&gt;Pipewright (open source) on Google Cloud, with private GKE&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#5F6368"&gt;The same environment, with pipelines on Kubeflow Pipelines, Ray on KubeRay and online serving on KServe in a private GKE cluster. The manifest says &lt;b&gt;orchestrator: kfp&lt;/b&gt;; templates, contracts, the CLI and everything outside the cluster are unchanged.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1780" height="60" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:15px"&gt;Your Google Cloud project (one per environment: dev, test, prod)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8F9FA;strokeColor=#DADCE0;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="1560" height="760" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px;color:#5F6368"&gt;CONFIGURATION AND RELEASES&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="122" width="1500" height="190" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:12px;color:#5F6368"&gt;TRIGGERS AND RUNS&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="1500" height="282" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px;color:#5F6368"&gt;RESULTS AND SIGNALS&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="630" width="1500" height="190" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=actor;html=1;fillColor=#1A73E8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="113" y="150" width="44" height="54" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:15px"&gt;Platform team&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;builds the environment and&lt;br&gt;the cluster, publishes the manifest&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="190" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:15px&quot;&gt;Upstream systems&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;files under the team's&lt;br&gt;landing prefix&lt;/span&gt;" style="rounded=1;arcSize=4;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#F1F3F4;strokeColor=#80868B;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="190" height="92" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=actor;html=1;fillColor=#E37400;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="113" y="520" width="44" height="54" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b style="font-size:15px"&gt;Approvers&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;ML leads, model risk&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="582" width="190" height="60" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=actor;html=1;fillColor=#188038;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="113" y="860" width="44" height="54" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b style="font-size:15px"&gt;ML team&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;YAML + pipeline code,&lt;br&gt;pipewright CLI&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="922" width="190" height="60" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b style="font-size:12px"&gt;Cloud Storage: artifacts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;manifest, release contracts,&lt;br&gt;pipeline roots&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="170" width="176" height="104" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="396.0" y="179" width="44" height="44" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b style="font-size:12px"&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;component and Ray images,&lt;br&gt;templates, mirrored images&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545" y="170" width="176" height="104" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="611.0" y="179" width="44" height="44" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b style="font-size:12px"&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;schedules, retrain ticks&lt;br&gt;(or CronJobs in the cluster)&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="176" height="104" as="geometry"/></mxCell><mxCell id="c19" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="826.0" y="179" width="44" height="44" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b style="font-size:12px"&gt;IAM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;a runner service account per team,&lt;br&gt;bound to its Kubernetes one&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="170" width="200" height="104" as="geometry"/></mxCell><mxCell id="c21" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1078.0" y="179" width="44" height="44" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b style="font-size:12px"&gt;Cloud Storage: landing&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;files that start runs&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="176" height="92" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="396.0" y="409" width="44" height="44" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b style="font-size:12px"&gt;Pub/Sub&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;landing events, run requests,&lt;br&gt;events, approver groups&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545" y="400" width="176" height="104" as="geometry"/></mxCell><mxCell id="c25" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="611.0" y="409" width="44" height="44" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b style="font-size:12px"&gt;Pipewright launcher&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;Cloud Run, or a pull worker&lt;br&gt;in the cluster&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="400" width="176" height="104" as="geometry"/></mxCell><mxCell id="c27" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="826.0" y="409" width="44" height="44" as="geometry"/></mxCell><mxCell id="c28" value='&lt;b style="font-size:15px"&gt;&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#E8F0FE;strokeColor=#4285F4;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="360" width="780" height="230" as="geometry"/></mxCell><mxCell id="c29" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1014" y="370" width="34" height="38" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b style="font-size:15px"&gt;Private GKE cluster&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;private nodes and endpoint; the API through its DNS endpoint (IAM); Workload Identity&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1056" y="366" width="640" height="44" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b style=&quot;font-size:12px&quot;&gt;Kubeflow Pipelines&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;training, inference,&lt;br&gt;synthetic data; step pods&lt;br&gt;as the team's identity&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1016" y="420" width="144" height="118" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b style="font-size:12px"&gt;KubeRay&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;a RayCluster per run, or a&lt;br&gt;standing one per team&lt;br&gt;that scales to zero&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1168" y="420" width="144" height="118" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b style=&quot;font-size:12px&quot;&gt;KServe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;an InferenceService per&lt;br&gt;model, in the team's&lt;br&gt;serving namespace&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1320" y="420" width="144" height="118" as="geometry"/></mxCell><mxCell id="c34" value='&lt;b style="font-size:12px"&gt;CronJobs&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;use case schedules&lt;br&gt;(schedules backend&lt;br&gt;kubernetes)&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;dashed=1;dashPattern=5 3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1472" y="420" width="144" height="118" as="geometry"/></mxCell><mxCell id="c35" value='&lt;b style="font-size:12px"&gt;Pipelines UI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;read only, on localhost:&lt;br&gt;pipewright pipelines-ui&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=middle;spacingBottom=0;spacingLeft=4;spacingRight=4;dashed=1;dashPattern=5 3;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1624" y="420" width="144" height="118" as="geometry"/></mxCell><mxCell id="c36" value='&lt;b style="font-size:12px"&gt;Cloud Monitoring&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;email alerts,&lt;br&gt;decision emails&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="690" width="176" height="104" as="geometry"/></mxCell><mxCell id="c37" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="396.0" y="699" width="44" height="44" as="geometry"/></mxCell><mxCell id="c38" value='&lt;b style="font-size:12px"&gt;Cloud Logging&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;step logs with&lt;br&gt;the same labels&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545" y="690" width="176" height="104" as="geometry"/></mxCell><mxCell id="c39" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="611.0" y="699" width="44" height="44" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b style=&quot;font-size:12px&quot;&gt;Feature Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;feature groups over the&lt;br&gt;owners' feature tables&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="990" y="690" width="176" height="104" as="geometry"/></mxCell><mxCell id="c41" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1056.0" y="699" width="44" height="44" as="geometry"/></mxCell><mxCell id="c42" value='&lt;b style="font-size:12px"&gt;BigQuery&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;a dataset per team: data,&lt;br&gt;predictions, synthetic data&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1186" y="690" width="176" height="104" as="geometry"/></mxCell><mxCell id="c43" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1252.0" y="699" width="44" height="44" as="geometry"/></mxCell><mxCell id="c44" value='&lt;b style="font-size:12px"&gt;Model Registry&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;versions, champion;&lt;br&gt;what KServe serves&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1382" y="690" width="176" height="104" as="geometry"/></mxCell><mxCell id="c45" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1448.0" y="699" width="44" height="44" as="geometry"/></mxCell><mxCell id="c46" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b&gt;publish the manifest&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="205" as="sourcePoint"/><mxPoint x="330" y="205" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b&gt;pipewright release&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry x="0.5" relative="1" as="geometry"><mxPoint x="230" y="930" as="sourcePoint"/><mxPoint x="633" y="274" as="targetPoint"/><Array as="points"><mxPoint x="252" y="930"/><mxPoint x="252" y="320"/><mxPoint x="633" y="320"/></Array></mxGeometry></mxCell><mxCell id="c48" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b&gt;files&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="446" as="sourcePoint"/><mxPoint x="330" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="506" y="446" as="sourcePoint"/><mxPoint x="545" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="721" y="446" as="sourcePoint"/><mxPoint x="760" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b&gt;schedules&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="848" y="274" as="sourcePoint"/><mxPoint x="848" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b&gt;submit&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint x="936" y="470" as="sourcePoint"/><mxPoint x="1016" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b&gt;create, delete&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="400" as="sourcePoint"/><mxPoint x="1240" y="420" as="targetPoint"/><Array as="points"><mxPoint x="900" y="345"/><mxPoint x="1240" y="345"/></Array></mxGeometry></mxCell><mxCell id="c54" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;5&lt;/span&gt;&amp;nbsp;&lt;b&gt;features, point in time&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint x="1050" y="690" as="sourcePoint"/><mxPoint x="1050" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;6&lt;/span&gt;&amp;nbsp;&lt;b&gt;tables&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="538" as="sourcePoint"/><mxPoint x="1270" y="690" as="targetPoint"/><Array as="points"><mxPoint x="1100" y="620"/><mxPoint x="1270" y="620"/></Array></mxGeometry></mxCell><mxCell id="c56" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;6&lt;/span&gt;&amp;nbsp;&lt;b&gt;register&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="538" as="sourcePoint"/><mxPoint x="1400" y="690" as="targetPoint"/><Array as="points"><mxPoint x="1140" y="600"/><mxPoint x="1400" y="600"/></Array></mxGeometry></mxCell><mxCell id="c57" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;7&lt;/span&gt;&amp;nbsp;&lt;b&gt;events, logs&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1016" y="510" as="sourcePoint"/><mxPoint x="633" y="690" as="targetPoint"/><Array as="points"><mxPoint x="976" y="510"/><mxPoint x="976" y="662"/><mxPoint x="633" y="662"/></Array></mxGeometry></mxCell><mxCell id="c58" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545" y="742" as="sourcePoint"/><mxPoint x="506" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;7&lt;/span&gt;&amp;nbsp;&lt;b&gt;email&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="760" as="sourcePoint"/><mxPoint x="230" y="760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;8&lt;/span&gt;&amp;nbsp;&lt;b&gt;pipewright retrain approve&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="560" as="sourcePoint"/><mxPoint x="633" y="504" as="targetPoint"/><Array as="points"><mxPoint x="633" y="560"/></Array></mxGeometry></mxCell><mxCell id="c61" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;9&lt;/span&gt;&amp;nbsp;&lt;b&gt;deploy-model&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint x="1440" y="690" as="sourcePoint"/><mxPoint x="1440" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value='&lt;b style="font-size:12px;color:#5F6368"&gt;WHAT THE PRIVATE CLUSTER ADDS&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8F9FA;strokeColor=#9AA0A6;strokeWidth=1;dashed=1;dashPattern=6 4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="860" width="1560" height="190" as="geometry"/></mxCell><mxCell id="c63" value='&lt;b style="font-size:12px"&gt;Cloud KMS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;node disks, cluster secrets,&lt;br&gt;buckets, models&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="930" width="176" height="104" as="geometry"/></mxCell><mxCell id="c64" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="396.0" y="939" width="44" height="44" as="geometry"/></mxCell><mxCell id="c65" value='&lt;b style="font-size:12px"&gt;VPC&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;pod and service ranges,&lt;br&gt;private DNS&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545" y="930" width="176" height="104" as="geometry"/></mxCell><mxCell id="c66" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="611.0" y="939" width="44" height="44" as="geometry"/></mxCell><mxCell id="c67" value="&lt;span style=&quot;font-size:12px&quot;&gt;The cluster has no public endpoint: Pipewright reaches the Kubernetes API through its &lt;b&gt;DNS endpoint&lt;/b&gt; as a Google identity (no kubeconfig), with the CA from the manifest. Each team's Kubeflow steps run as its runner service account through &lt;b&gt;Workload Identity&lt;/b&gt;. Kubeflow, Argo, KubeRay, KServe and Ray images are &lt;b&gt;mirrored&lt;/b&gt; into Artifact Registry. Run requests go over Pub/Sub, so the launcher can run on Cloud Run or &lt;b&gt;inside the cluster&lt;/b&gt;, pulling its subscriptions; schedules can be &lt;b&gt;CronJobs&lt;/b&gt;. Each is one setting in the manifest, made by the platform team.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="936" width="1040" height="100" as="geometry"/></mxCell><mxCell id="c68" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Publish.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The platform team builds the environment and the cluster, and publishes the manifest: orchestrator kfp and its kubernetes block.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="900" height="40" as="geometry"/></mxCell><mxCell id="c69" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Release.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The ML team releases: the same images and templates as on Agent Platform, by digest, and a write-once contract.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="900" height="40" as="geometry"/></mxCell><mxCell id="c70" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Trigger.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Files, schedules (Cloud Scheduler or CronJobs) and run requests reach the shared launcher.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="900" height="40" as="geometry"/></mxCell><mxCell id="c71" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Run.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The launcher creates the Kubeflow run through the Kubernetes API; a Ray step gets its own RayCluster, or the team&amp;#x27;s standing one.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="900" height="40" as="geometry"/></mxCell><mxCell id="c72" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;5&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Features.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Ingest reads the team&amp;#x27;s features as they were at each row&amp;#x27;s cut-off.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="900" height="40" as="geometry"/></mxCell><mxCell id="c73" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;6&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Store.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Pipelines write the team&amp;#x27;s tables (synthetic data too, once its gates pass) and register models; the default version is the champion.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1080" width="880" height="40" as="geometry"/></mxCell><mxCell id="c74" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;7&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Signal.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Step logs and events keep their labels: the same email alerts, decision emails and BigQuery events.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1120" width="880" height="40" as="geometry"/></mxCell><mxCell id="c75" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;8&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Decide.&lt;/b&gt; &lt;span style="font-size:12px"&gt;On drift, approvers approve, decline or snooze; an approved retrain runs.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1160" width="880" height="40" as="geometry"/></mxCell><mxCell id="c76" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;9&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Serve.&lt;/b&gt; &lt;span style="font-size:12px"&gt;deploy-model puts a version on KServe, inside the cluster or behind an internal load balancer; pipewright model predict; the request format of Agent Platform endpoints.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1200" width="880" height="40" as="geometry"/></mxCell><mxCell id="c77" value='&lt;span style="font-size:11px;color:#5F6368"&gt;Icons: the official Google Cloud set (Kubeflow Pipelines, KubeRay and KServe are open-source projects installed in the cluster). Dashed: optional, one setting in the manifest. The Agent Platform version of this picture: pipewright-architecture.png.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="1780" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
