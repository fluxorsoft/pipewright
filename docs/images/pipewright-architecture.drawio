<mxfile host="app.diagrams.net"><diagram id="oss" name="Pipewright on Google Cloud"><mxGraphModel dx="1600" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1380" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:22px"&gt;Pipewright (open source) on Google Cloud&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#5F6368"&gt;The Google Cloud building blocks one environment needs, and how Pipewright uses them. The platform team builds them once; ML teams work only with configuration, code and the &lt;b&gt;pipewright&lt;/b&gt; CLI.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1500" height="60" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:15px"&gt;Your Google Cloud project (one per environment: dev, test, prod)&lt;/b&gt;' style="rounded=1;arcSize=4;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fillColor=#F8F9FA;strokeColor=#DADCE0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="1290" height="940" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px;color:#5F6368"&gt;CONFIGURATION AND RELEASES&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="122" width="1230" height="222" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:12px;color:#5F6368"&gt;TRIGGERS AND RUNS&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="362" width="1230" height="372" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px;color:#5F6368"&gt;RESULTS AND SIGNALS&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="752" width="1230" height="248" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=actor;html=1;fillColor=#1A73E8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="113" y="164" width="44" height="54" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:15px"&gt;Platform team&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;builds the environment,&lt;br&gt;publishes the manifest&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="190" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:15px&quot;&gt;Upstream systems&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;files under the team's&lt;br&gt;landing prefix&lt;/span&gt;" style="rounded=1;arcSize=4;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fillColor=#F1F3F4;strokeColor=#80868B;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="190" height="92" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=actor;html=1;fillColor=#E37400;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="113" y="548" width="44" height="54" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b style="font-size:15px"&gt;Approvers&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;ML leads, model risk&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="190" height="50" as="geometry"/></mxCell><mxCell id="c12" value="" style="shape=actor;html=1;fillColor=#188038;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="113" y="868" width="44" height="54" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b style="font-size:15px"&gt;ML team&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;YAML + pipeline code,&lt;br&gt;pipewright CLI&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="190" height="50" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b style="font-size:12px"&gt;Cloud Storage: artifacts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;manifest, release contracts,&lt;br&gt;retrain cases&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.2;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="342.0" y="188" width="176" height="104" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="407" y="194" width="46" height="46" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b style="font-size:12px"&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;component and Ray images,&lt;br&gt;pipeline templates&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.2;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="572.0" y="188" width="176" height="104" as="geometry"/></mxCell><mxCell id="c17" valu