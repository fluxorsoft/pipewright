<mxfile host="app.diagrams.net"><diagram id="Pipewright on Agent Platform" name="Pipewright on Agent Platform"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1500" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:22px"&gt;Pipewright (open source) on Google Cloud&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#5F6368"&gt;The Google Cloud building blocks one environment needs, and how Pipewright 1.4.3 uses them. The platform team builds them once; ML teams work only with configuration, code and the &lt;b&gt;pipewright&lt;/b&gt; CLI. Every run goes through one door, the launcher; a person decides where it matters.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1780" height="60" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:15px"&gt;Your Google Cloud project (one per environment: dev, test, prod)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8F9FA;strokeColor=#DADCE0;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="1560" height="1000" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:12px;color:#5F6368"&gt;CONFIGURATION AND RELEASES&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="122" width="1500" height="190" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:12px;color:#5F6368"&gt;TRIGGERS AND RUNS&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="1500" height="300" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:12px;color:#5F6368"&gt;RESULTS AND SIGNALS&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="650" width="1500" height="190" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:12px;color:#5F6368"&gt;ONLINE SERVING (OPTIONAL)&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="860" width="1500" height="200" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=actor;html=1;fillColor=#1A73E8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="113" y="150" width="44" height="54" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:15px"&gt;Platform team&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;builds the environment,&lt;br&gt;publishes the manifest&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="190" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:15px&quot;&gt;Upstream systems&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;files under the team's&lt;br&gt;landing prefix&lt;/span&gt;" style="rounded=1;arcSize=4;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#F1F3F4;strokeColor=#80868B;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="190" height="92" as="geometry"/></mxCell><mxCell id="c11" value="" style="shape=actor;html=1;fillColor=#E37400;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="113" y="520" width="44" height="54" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b style="font-size:15px"&gt;Approvers&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;ML leads, model risk;&lt;br&gt;in the CLI or a GitHub gate&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="582" width="190" height="60" as="geometry"/></mxCell><mxCell id="c13" value="" style="shape=actor;html=1;fillColor=#188038;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="113" y="790" width="44" height="54" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b style="font-size:15px"&gt;ML team&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;YAML + pipeline code,&lt;br&gt;pipewright CLI&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="852" width="190" height="60" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b style="font-size:15px"&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;pipewright ci init: checks,&lt;br&gt;release, decisions, gates,&lt;br&gt;promote; reviewers per&lt;br&gt;environment&lt;/span&gt;' style="rounded=1;arcSize=4;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#F1F3F4;strokeColor=#80868B;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="190" height="110" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b style="font-size:12px"&gt;Cloud Storage: artifacts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;manifest, release contracts,&lt;br&gt;held runs, retrain cases&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="170" width="176" height="104" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="396.0" y="179" width="44" height="44" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b style="font-size:12px"&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;component and Ray images,&lt;br&gt;pipeline templates&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545" y="170" width="176" height="104" as="geometry"/></mxCell><mxCell id="c19" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="611.0" y="179" width="44" height="44" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b style="font-size:12px"&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;schedules,&lt;br&gt;retrain ticks&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="176" height="104" as="geometry"/></mxCell><mxCell id="c21" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="826.0" y="179" width="44" height="44" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b style="font-size:12px"&gt;IAM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;launcher, a runner per team;&lt;br&gt;CI signs in by WIF, no keys&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="170" width="200" height="104" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1078.0" y="179" width="44" height="44" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b style="font-size:12px"&gt;Cloud Storage: landing&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;files that start runs&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="176" height="92" as="geometry"/></mxCell><mxCell id="c25" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="396.0" y="409" width="44" height="44" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b style="font-size:12px"&gt;Pub/Sub&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;landing events, run requests,&lt;br&gt;decisions, incidents&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545" y="400" width="176" height="104" as="geometry"/></mxCell><mxCell id="c27" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="611.0" y="409" width="44" height="44" as="geometry"/></mxCell><mxCell id="c28" value='&lt;b style="font-size:12px"&gt;Pipewright launcher&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;one door: the rules, held&lt;br&gt;scoring runs, registration&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E37400;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="400" width="176" height="104" as="geometry"/></mxCell><mxCell id="c29" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="826.0" y="409" width="44" height="44" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b style="font-size:12px"&gt;Agent Platform Pipelines&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;training, scoring,&lt;br&gt;monitoring, synthetic data&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="200" height="104" as="geometry"/></mxCell><mxCell id="c31" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1078.0" y="409" width="44" height="44" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b style="font-size:12px"&gt;Model Registry&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;versions, champion,&lt;br&gt;approvals&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1260" y="400" width="176" height="104" as="geometry"/></mxCell><mxCell id="c33" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1326.0" y="409" width="44" height="44" as="geometry"/></mxCell><mxCell id="c34" value='&lt;b style="font-size:12px"&gt;Ray on Agent Platform&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;a cluster per Ray step&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="528" width="150" height="90" as="geometry"/></mxCell><mxCell id="c35" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1053.0" y="537" width="44" height="44" as="geometry"/></mxCell><mxCell id="c36" value='&lt;b style="font-size:12px"&gt;Cloud Monitoring&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;alert policies: serving&lt;br&gt;health, drift, failed runs&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="700" width="176" height="104" as="geometry"/></mxCell><mxCell id="c37" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="396.0" y="709" width="44" height="44" as="geometry"/></mxCell><mxCell id="c38" value='&lt;b style="font-size:12px"&gt;Cloud Logging&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;labelled logs&lt;br&gt;and events&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545" y="700" width="176" height="104" as="geometry"/></mxCell><mxCell id="c39" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="611.0" y="709" width="44" height="44" as="geometry"/></mxCell><mxCell id="c40" value='&lt;b style="font-size:12px"&gt;Events topic&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;89 event types; each team&lt;br&gt;subscribes to its own&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="700" width="176" height="104" as="geometry"/></mxCell><mxCell id="c41" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="826.0" y="709" width="44" height="44" as="geometry"/></mxCell><mxCell id="c42" value='&lt;b style="font-size:12px"&gt;Event log&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;every event, kept&lt;br&gt;in BigQuery&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="990" y="700" width="176" height="104" as="geometry"/></mxCell><mxCell id="c43" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1056.0" y="709" width="44" height="44" as="geometry"/></mxCell><mxCell id="c44" value='&lt;b style="font-size:12px"&gt;BigQuery&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;a dataset per team: data,&lt;br&gt;scores, captured requests&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1186" y="700" width="176" height="104" as="geometry"/></mxCell><mxCell id="c45" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1252.0" y="709" width="44" height="44" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b style=&quot;font-size:12px&quot;&gt;Feature Store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6368&quot;&gt;feature groups over the&lt;br&gt;owners' feature tables&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1382" y="700" width="176" height="104" as="geometry"/></mxCell><mxCell id="c47" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1448.0" y="709" width="44" height="44" as="geometry"/></mxCell><mxCell id="c48" value='&lt;span style="font-size:12px"&gt;An endpoint serves an approved version, with a &lt;b&gt;canary&lt;/b&gt; or an &lt;b&gt;A/B test&lt;/b&gt; that splits customers between two versions. With online features, callers send only an ID: the &lt;b&gt;lookup gateway&lt;/b&gt; reads the latest features from the online store (Bigtable, Cloud SQL or BigQuery, synced from the feature tables) and calls the endpoint. &lt;b&gt;Serving health&lt;/b&gt; alert policies watch each deployed version, and a sample of requests can be &lt;b&gt;captured&lt;/b&gt; to check quality on live traffic. Endpoints can be private, over Private Service Connect. On private GKE, KServe serves instead.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="900" width="630" height="150" as="geometry"/></mxCell><mxCell id="c49" value='&lt;b style="font-size:12px"&gt;Lookup gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;callers send an ID;&lt;br&gt;features read for them&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="990" y="910" width="176" height="104" as="geometry"/></mxCell><mxCell id="c50" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1056.0" y="919" width="44" height="44" as="geometry"/></mxCell><mxCell id="c51" value='&lt;b style="font-size:12px"&gt;Online store&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;Bigtable, Cloud SQL&lt;br&gt;or BigQuery&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1186" y="910" width="176" height="104" as="geometry"/></mxCell><mxCell id="c52" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1252.0" y="919" width="44" height="44" as="geometry"/></mxCell><mxCell id="c53" value='&lt;b style="font-size:12px"&gt;Endpoints&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;canary and A/B arms,&lt;br&gt;capture, private (PSC)&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1382" y="910" width="176" height="104" as="geometry"/></mxCell><mxCell id="c54" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1448.0" y="919" width="44" height="44" as="geometry"/></mxCell><mxCell id="c55" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b&gt;publish the manifest&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="205" as="sourcePoint"/><mxPoint x="330" y="205" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b&gt;release, after a reviewer&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry x="0.5" relative="1" as="geometry"><mxPoint x="230" y="985" as="sourcePoint"/><mxPoint x="633" y="274" as="targetPoint"/><Array as="points"><mxPoint x="252" y="985"/><mxPoint x="252" y="320"/><mxPoint x="633" y="320"/></Array></mxGeometry></mxCell><mxCell id="c57" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b&gt;files&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="446" as="sourcePoint"/><mxPoint x="330" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="506" y="446" as="sourcePoint"/><mxPoint x="545" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="721" y="446" as="sourcePoint"/><mxPoint x="760" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b&gt;schedules&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="848" y="274" as="sourcePoint"/><mxPoint x="848" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b&gt;submit&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint x="936" y="446" as="sourcePoint"/><mxPoint x="1000" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value="&lt;b&gt;Ray&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="936" y="480" as="sourcePoint"/><mxPoint x="1000" y="573" as="targetPoint"/><Array as="points"><mxPoint x="968" y="480"/><mxPoint x="968" y="573"/></Array></mxGeometry></mxCell><mxCell id="c63" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;6&lt;/span&gt;&amp;nbsp;&lt;b&gt;register&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="446" as="sourcePoint"/><mxPoint x="1260" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value="&lt;b&gt;or the launcher registers, after its checks&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#E37400;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="400" as="sourcePoint"/><mxPoint x="1348" y="400" as="targetPoint"/><Array as="points"><mxPoint x="900" y="350"/><mxPoint x="1348" y="350"/></Array></mxGeometry></mxCell><mxCell id="c65" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;5&lt;/span&gt;&amp;nbsp;&lt;b&gt;features, point in time&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint x="1470" y="700" as="sourcePoint"/><mxPoint x="1190" y="504" as="targetPoint"/><Array as="points"><mxPoint x="1470" y="650"/><mxPoint x="1190" y="650"/></Array></mxGeometry></mxCell><mxCell id="c66" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;6&lt;/span&gt;&amp;nbsp;&lt;b&gt;tables&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry x="0.3" relative="1" as="geometry"><mxPoint x="1165" y="504" as="sourcePoint"/><mxPoint x="1274" y="700" as="targetPoint"/><Array as="points"><mxPoint x="1165" y="665"/><mxPoint x="1274" y="665"/></Array></mxGeometry></mxCell><mxCell id="c67" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;7&lt;/span&gt;&amp;nbsp;&lt;b&gt;events&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry x="0.2" relative="1" as="geometry"><mxPoint x="848" y="504" as="sourcePoint"/><mxPoint x="848" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c68" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="936" y="752" as="sourcePoint"/><mxPoint x="990" y="752" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;7&lt;/span&gt;&amp;nbsp;&lt;b&gt;incidents&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry x="-0.4" relative="1" as="geometry"><mxPoint x="490" y="700" as="sourcePoint"/><mxPoint x="800" y="504" as="targetPoint"/><Array as="points"><mxPoint x="490" y="640"/><mxPoint x="800" y="640"/></Array></mxGeometry></mxCell><mxCell id="c70" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;7&lt;/span&gt;&amp;nbsp;&lt;b&gt;email&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="752" as="sourcePoint"/><mxPoint x="230" y="752" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c71" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;8&lt;/span&gt;&amp;nbsp;&lt;b&gt;decide: CLI or GitHub gate&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="560" as="sourcePoint"/><mxPoint x="633" y="504" as="targetPoint"/><Array as="points"><mxPoint x="633" y="560"/></Array></mxGeometry></mxCell><mxCell id="c72" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;9&lt;/span&gt;&amp;nbsp;&lt;b&gt;deploy&lt;/b&gt;' style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1436" y="452" as="sourcePoint"/><mxPoint x="1558" y="962" as="targetPoint"/><Array as="points"><mxPoint x="1800" y="452"/><mxPoint x="1800" y="962"/></Array></mxGeometry></mxCell><mxCell id="c73" value="&lt;b&gt;sync&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="804" as="sourcePoint"/><mxPoint x="1274" y="910" as="targetPoint"/><Array as="points"><mxPoint x="1440" y="850"/><mxPoint x="1274" y="850"/></Array></mxGeometry></mxCell><mxCell id="c74" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1166" y="962" as="sourcePoint"/><mxPoint x="1186" y="962" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c75" value="&lt;b&gt;calls the endpoint&lt;/b&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5F6368;strokeWidth=1.7;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1078" y="1014" as="sourcePoint"/><mxPoint x="1470" y="1014" as="targetPoint"/><Array as="points"><mxPoint x="1078" y="1040"/><mxPoint x="1470" y="1040"/></Array></mxGeometry></mxCell><mxCell id="c76" value='&lt;b style="font-size:12px;color:#5F6368"&gt;OPTIONAL, FOR REGULATED ENVIRONMENTS&lt;/b&gt;' style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8F9FA;strokeColor=#9AA0A6;strokeWidth=1;dashed=1;dashPattern=6 4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="1100" width="1560" height="170" as="geometry"/></mxCell><mxCell id="c77" value='&lt;b style="font-size:12px"&gt;Cloud KMS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;customer-managed keys&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1150" width="176" height="104" as="geometry"/></mxCell><mxCell id="c78" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="396.0" y="1159" width="44" height="44" as="geometry"/></mxCell><mxCell id="c79" value='&lt;b style="font-size:12px"&gt;VPC&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#5F6368"&gt;private networking&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=1.3;verticalAlign=bottom;spacingBottom=6;spacingLeft=4;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="545" y="1150" width="176" height="104" as="geometry"/></mxCell><mxCell id="c80" value="" style="shape=image;aspect=fixed;imageAspect=0;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="611.0" y="1159" width="44" height="44" as="geometry"/></mxCell><mxCell id="c81" value="&lt;span style=&quot;font-size:12px&quot;&gt;Name a key and a network in the manifest's &lt;b&gt;security&lt;/b&gt; block and Pipewright applies them to every pipeline job, model, endpoint and BigQuery query. Run requests and decisions go over Pub/Sub, so the launcher can stay internal-only behind Private Service Connect and VPC Service Controls. Ray clusters join the network through a Private Service Connect interface.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="1158" width="1040" height="100" as="geometry"/></mxCell><mxCell id="c82" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Publish.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The platform team builds the environment and publishes the environment manifest.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="900" height="40" as="geometry"/></mxCell><mxCell id="c83" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Release.&lt;/b&gt; &lt;span style="font-size:12px"&gt;A merge releases, after the environment&amp;#x27;s reviewers: images and templates by digest, and a write-once contract.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="900" height="40" as="geometry"/></mxCell><mxCell id="c84" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;3&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Trigger.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Files, schedules and run requests (API, CLI, workflows) reach the launcher over Pub/Sub.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="900" height="40" as="geometry"/></mxCell><mxCell id="c85" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;4&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Run.&lt;/b&gt; &lt;span style="font-size:12px"&gt;The launcher applies the rules, can hold a scoring run for a person, then submits as the team&amp;#x27;s runner; a Ray step gets its own cluster.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="900" height="40" as="geometry"/></mxCell><mxCell id="c86" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;5&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Features.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Ingest reads the team&amp;#x27;s features as they were at each row&amp;#x27;s cut-off.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1460" width="900" height="40" as="geometry"/></mxCell><mxCell id="c87" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;6&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Store.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Pipelines write the team&amp;#x27;s tables and register models, or ask the launcher to; the default version is the champion.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1300" width="880" height="40" as="geometry"/></mxCell><mxCell id="c88" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;7&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Signal.&lt;/b&gt; &lt;span style="font-size:12px"&gt;Every step sends an event to one topic, and each team subscribes to its own; alerts and serving health incidents arrive the same way.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1340" width="880" height="40" as="geometry"/></mxCell><mxCell id="c89" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;8&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Decide.&lt;/b&gt; &lt;span style="font-size:12px"&gt;A person decides in the CLI or a GitHub gate: retrains, new defaults, deploys, A/B tests, held scoring runs.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1380" width="880" height="40" as="geometry"/></mxCell><mxCell id="c90" value='&lt;span style="background:#0B6B67;color:#fff;border-radius:9px;padding:1px 6px;font-weight:bold"&gt;9&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:12px"&gt;Serve.&lt;/b&gt; &lt;span style="font-size:12px"&gt;An approved version is deployed with a canary or an A/B test; callers send features, or only an ID through the lookup gateway.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1420" width="880" height="40" as="geometry"/></mxCell><mxCell id="c91" value='&lt;span style="font-size:11px;color:#5F6368"&gt;Icons: the official Google Cloud set. Agent Platform services carry the Vertex AI icon (Gemini Enterprise Agent Platform was called Vertex AI until April 2026). Amber: where a person decides. The private GKE version: pipewright-gke-architecture.png.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="1780" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
